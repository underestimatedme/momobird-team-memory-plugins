{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "momobird_memory": {
      "type": "streamable-http",
      "url": "https://api.valley.atlaspaces.com/api/momobird/public/memory/plugin/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "resource": "https://api.valley.atlaspaces.com/api/momobird/public/memory/plugin/mcp",
            "baseScopes": [
              "team_memory:read_propose"
            ],
            "defaultScopes": []
          }
        }
      }
    }
  }
}
